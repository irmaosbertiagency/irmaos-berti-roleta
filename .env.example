# ===========================================================================
# Roleta Irmãos Berti — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com os valores do seu Supabase.
# No Netlify, cadastre estas 3 variáveis em: Site settings → Environment variables.
# ===========================================================================

# Supabase → Project Settings → API
#   - Project URL
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
#   - Project API keys → "anon public" (pode ficar no front, é seguro)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Senha do painel /admin (troque por uma senha forte)
VITE_ADMIN_PASSWORD=troque-esta-senha
